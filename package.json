{
  "name": "pdfrevisao-main",
  "version": "1.0.0",
  "description": "Sistema de Resumos para Concursos - Visual Regression Tests",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:update": "playwright test --update-snapshots",
    "test:visual": "playwright test tests/visual-regression.spec.ts",
    "test:visual:update": "playwright test tests/visual-regression.spec.ts --update-snapshots",
    "test:visual:headed": "playwright test tests/visual-regression.spec.ts --headed",
    "test:report": "playwright show-report",
    "install:browsers": "playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "playwright": "^1.64.1"
  }
}